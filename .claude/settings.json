{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/md-linewrap.sh\" 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Checking Markdown line width"
          }
        ]
      }
    ]
  }
}
